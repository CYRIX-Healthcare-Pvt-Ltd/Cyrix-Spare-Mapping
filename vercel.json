{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/spare/((?!assets/|icons/|.*.[a-zA-Z0-9]+$).*)",
      "destination": "/spare/index.html"
    }
  ],
  "headers": [
    {
      "source": "/spare/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/spare/(index.html|sw.js|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cyrix-spare-mapping.vercel.app"
        }
      ],
      "destination": "https://app.cyrix.in/spare/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/spare/",
      "permanent": false
    }
  ]
}
